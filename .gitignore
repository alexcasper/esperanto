
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Normalized corpus derived from RAW/ (regenerate: python3 tools/normalize_corpus.py)
CORPUS/*.txt

# generated by the map step; agents edit their own shard, reconcile merges them
DICT/shards/
DICT/candidates.jsonl

# Python bytecode
__pycache__/
*.pyc

# Tatoeba export blobs (fetch: python3 tools/fetch_tatoeba.py; digests in RAW/tatoeba/README.md)
RAW/tatoeba/*
!RAW/tatoeba/README.md
# Derived en-epo pair corpus (rebuild: python3 tools/build_tatoeba_pairs.py)
CORPUS/tatoeba/pairs.tsv

# Usenet archive blobs (fetch: python3 tools/fetch_raw_usenet.py; digests in RAW/usenet/README.md)
RAW/usenet/*
!RAW/usenet/README.md
# Licence-hold bulk extraction (regenerate: python3 tools/extract_usenet_esperanto.py)
QUARANTINE/soc.culture.esperanto/extracted.tsv
